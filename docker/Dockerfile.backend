FROM golang:1.22-bookworm AS build

WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -o /out/faro-api ./cmd/faro-api

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/faro-api /usr/local/bin/faro-api
COPY coredns/sample-blocklist.txt /app/coredns/sample-blocklist.txt
EXPOSE 8080
ENTRYPOINT ["faro-api"]
