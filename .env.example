# Use the Faro host's fixed LAN IP when a local resolver already owns loopback port 53.
FARO_BIND_ADDRESS=0.0.0.0
FARO_UI_PORT=1787
FARO_DNS_PORT=53
# Development Compose uses a non-privileged port to avoid macOS DNS services.
FARO_DEV_DNS_PORT=5354

# Bound the raw query-log buffer. Retained history lives in Faro's database.
FARO_QUERY_LOG_MAX_BYTES=10485760
FARO_QUERY_LOG_BACKUPS=2

# Bound stdout/stderr captured by Docker for each Faro container.
FARO_DOCKER_LOG_MAX_SIZE=10m
FARO_DOCKER_LOG_BACKUPS=3

# Optional image source and release override. Leave FARO_VERSION unset to
# follow the current release automatically; set it only for rollback or a
# deliberately pinned deployment.
FARO_IMAGE_NAMESPACE=tabierto
# FARO_VERSION=0.10.0
