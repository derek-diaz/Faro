.:53 {
    errors
    metadata
    log . "FARO|{remote}|{type}|{name}|{rcode}|{duration}|{/forward/upstream}"
    prometheus 0.0.0.0:9153
    reload 2s
    hosts /etc/coredns/faro.hosts {
        ttl 60
        fallthrough
    }
    cache 300 {
        success 9984 300 5
        denial 4096 60 5
    }
    forward . 1.1.1.1 9.9.9.9
}
